{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/be-first",
      "destination": "/index.html"
    },
    {
      "source": "/be-first/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/be-first/assets/story/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
